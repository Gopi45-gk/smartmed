# SmartMed AI - Environment Configuration
# Copy this file to .env and adjust values as needed.

# Path to the directory containing MNN model files
MNN_MODEL_PATH=./ai/mnn/model

# Human-readable model name (for display in UI)
MNN_MODEL_NAME=Qwen2.5-0.5B-Instruct-MNN

# Inference device: cpu, opencl, cuda, metal
MNN_DEVICE=cpu

# Maximum number of tokens to generate per response
MNN_MAX_NEW_TOKENS=512

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
MNN_TEMPERATURE=0.7

# Maximum context length (prompt + response)
MNN_CONTEXT_LENGTH=2048

# Number of CPU threads for inference
MNN_THREAD_NUM=4

# Port for the AI inference server
SMARTMED_AI_PORT=8100

# Inference timeout in seconds
MNN_INFERENCE_TIMEOUT=120
