# SmartMed AI - Environment Configuration
# Copy this file to .env and adjust values as needed.

# Path to the directory containing MNN model files
MNN_MODEL_PATH=./ai/mnn/model

# Human-readable model name (for display in UI)
MNN_MODEL_NAME=Qwen2.5-0.5B-Instruct-MNN

# Inference device: cpu, opencl, cuda, metal
MNN_DEVICE=cpu

# Maximum number of tokens to generate per response
MNN_MAX_NEW_TOKENS=512

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
MNN_TEMPERATURE=0.7

# Maximum context length (prompt + response)
MNN_CONTEXT_LENGTH=2048

# Number of CPU threads for inference
MNN_THREAD_NUM=4

# Port for the AI inference server
SMARTMED_AI_PORT=8100

# Inference timeout in seconds
MNN_INFERENCE_TIMEOUT=120

# ─── AWS Cloud & Online API Configuration ─────────────────────────────────────
# NVIDIA NIM Inference Microservices (Online Medical LLM)
AI_API_KEY=nvapi-your-key-here
AI_API_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL_CHAT=meta/llama-3.1-8b-instruct
AI_MODEL_VOICE=openai/gpt-oss-120b

# OpenFDA Drug Label API Key (Optional, higher rate limits)
OPENFDA_API_KEY=

# WHO ICD-11 OAuth2 Credentials (https://icd.who.int/icdapi)
MEDI_CLIENT_ID=
MEDI_CLIENT_SECRET=

# Data.gov.in Jan Aushadhi Generic Drug API Key
DATA_GOV_IN_API_KEY=

# Exotel Telephony / IVR Webhook Configuration
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=

